{
  "name": "smart-watering-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo для розумного поливу: Next.js web-app + ESP8266 firmware",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter web-app dev",
    "build": "pnpm --filter web-app build",
    "lint": "pnpm --filter web-app lint",
    "provision-device": "pnpm --filter web-app provision-device",
    "db:generate": "pnpm --filter web-app db:generate",
    "db:migrate": "pnpm --filter web-app db:migrate",
    "db:push": "pnpm --filter web-app db:push",
    "test:e2e": "pnpm --filter web-app test:e2e",
    "test:e2e:ui": "pnpm --filter web-app test:e2e:ui",
    "test:e2e:install": "pnpm --filter web-app test:e2e:install",
    "test:e2e:clean": "pnpm --filter web-app test:e2e:clean"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
