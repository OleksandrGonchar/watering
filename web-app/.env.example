# Postgres connection (Vercel Postgres / Neon / local)
# DATABASE_URL = pooled connection (для рантайму на Vercel)
# DIRECT_URL   = пряме з'єднання (для prisma migrate / studio)
# Локально обидва можуть вказувати на один і той самий URL.
DATABASE_URL="postgresql://user:password@localhost:5432/smart_watering?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/smart_watering?schema=public"

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Device JWT (generate via: openssl rand -hex 32)
DEVICE_JWT_SECRET=
